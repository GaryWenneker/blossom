# Copy to .env, load with your shell or a secret manager (Node does not auto-load .env).
BLOSSOM_ADMIN_PASSWORD=replace-with-a-long-random-password
BLOSSOM_HOST=127.0.0.1
BLOSSOM_PORT=8787
BLOSSOM_DB=.data/blossom.db
# Default false. Production music delivery is impossible until consciously enabled.
BLOSSOM_ALLOW_LIVE_DISTRIBUTION=false
# Obtain these from LabelGrid only after activating an API plan.
LABELGRID_API_TOKEN=
# Optional: https URL with hostname api.labelgrid.com or its verified sandbox subdomain.
LABELGRID_BASE_URL=https://api.labelgrid.com/api/public
# Optional monitoring while this process is running. Failure alerts require operations monitoring.
BLOSSOM_MONITOR_ENABLED=false

# Login at /login for 1Password or your browser password manager.
BLOSSOM_ADMIN_USERNAME=admin
# Generate with npm run vault:key and store outside GitHub.
BLOSSOM_VAULT_KEY=
# Exact public origin for OAuth callbacks and Secure cookies (HTTPS when remote).
BLOSSOM_PUBLIC_URL=http://127.0.0.1:8787
